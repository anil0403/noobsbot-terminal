# Maintainer: anil <dev.shresthaanil@gmail.com>
pkgname=noobsbot-git
_repo=noobsbot-terminal
pkgver=r0
pkgrel=1
pkgdesc='GPU-rendered terminal emulator with situation-aware color palettes'
arch=('x86_64' 'aarch64')
url="https://github.com/anil0403/$_repo"
license=('MIT')
# The X11, Wayland, Vulkan and EGL libraries are loaded at runtime, not linked.
# nano: the default editor (EDITOR, when none is set) for git, gh and file links.
# ttf-jetbrains-mono-nerd: the default font, with the prompt's icons.
depends=('gcc-libs' 'glibc' 'libx11' 'libxcursor' 'libxi' 'libxkbcommon-x11' 'vulkan-icd-loader' 'nano' 'ttf-jetbrains-mono-nerd')
makedepends=('cargo' 'git' 'ncurses')
optdepends=('wayland: run on Wayland'
            'libglvnd: OpenGL fallback when Vulkan is unavailable'
            'kitty: kitten icat, to show images')
provides=('noobsbot')
conflicts=('noobsbot')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_repo"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$_repo"
  install -Dm755 target/release/noobsbot "$pkgdir/usr/bin/noobsbot"
  install -Dm644 extra/noobsbot.desktop "$pkgdir/usr/share/applications/noobsbot.desktop"
  install -Dm644 extra/noobsbot.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/noobsbot.svg"
  install -dm755 "$pkgdir/usr/share/terminfo"
  tic -x -o "$pkgdir/usr/share/terminfo" extra/noobsbot.terminfo
  install -Dm644 config.example.toml README.md -t "$pkgdir/usr/share/doc/noobsbot"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
